# Copy to .env and adjust. Every setting is optional.

# Host port and interface. 127.0.0.1 = reachable only through a reverse proxy
# or tunnel on this machine. 0.0.0.0 exposes it to your whole network
# (Docker bypasses host firewalls such as UFW).
PORT=8765
BIND=127.0.0.1

# Public address guests use, for the invite link and QR code, e.g.
# https://cesura.example.com. Normally set in the setup wizard; this overrides it.
PUBLIC_URL=

# Network of your reverse proxy as seen from the container. X-Forwarded-For is
# only trusted from here. The default covers Docker's bridge networks.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# Key for the host dashboard (/host?key=...). Leave blank: the setup wizard
# generates one and stores it in config/. Setting it here overrides that.
HOST_KEY=

# Song the YouTube link check uses to detect Premium (256k AAC, format 141).
# Default: BSTsnWoslP4 (Queen - Bohemian Rhapsody). Change it if that's
# unavailable in your country.
PROBE_VIDEO_ID=

# Pocket mode's shared stream: aac (default) or mp3. Try mp3 only if some
# phones won't play pocket mode.
POCKET_CODEC=aac

# Speed cap for fetching songs from YouTube, in MB/s (0 = no cap). Songs
# download one at a time, so one download can't fill your link.
DOWNLOAD_RATE=2

# Artwork cache size in ./cache, in MB.
ART_CACHE_MB=300

# UID/GID the container runs as. It must be able to write ./config and ./cache.
CESURA_UID=1000
CESURA_GID=1000

# Only for ytmusicapi OAuth (optional).
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
